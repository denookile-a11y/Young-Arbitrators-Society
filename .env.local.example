# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings → API). Never commit .env.local.

# Public — safe to expose to the browser. RLS policies are what actually
# restrict access; these keys alone don't grant elevated permissions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it into
# any file reachable from a Client Component, and never log it. Only used
# for the rare server-side maintenance task that must bypass RLS entirely
# (e.g. a one-off backfill script run locally) — day-to-day admin CRUD
# should go through the anon key + RLS policies instead, so this key is
# NOT wired into the CMS by default.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/sitemap.ts and app/robots.ts to build absolute URLs. Set this
# to your real production domain once deployed — falls back to a placeholder
# otherwise, which is harmless locally but should never ship to production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
