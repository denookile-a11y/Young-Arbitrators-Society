# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings → API). Never commit .env.local.

# Public — safe to expose to the browser. RLS policies are what actually
# restrict access; these keys alone don't grant elevated permissions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it into
# any file reachable from a Client Component, and never log it. Only used
# for the rare server-side maintenance task that must bypass RLS entirely
# (e.g. a one-off backfill script run locally) — day-to-day admin CRUD
# should go through the anon key + RLS policies instead, so this key is
# NOT wired into the CMS by default.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/sitemap.ts and app/robots.ts to build absolute URLs. Set this
# to your real production domain once deployed — falls back to a placeholder
# otherwise, which is harmless locally but should never ship to production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Email (contact form, newsletter confirmation, announcement notifications)
# ALL server-side. None of these may ever be prefixed NEXT_PUBLIC_.
# Provider: Resend (https://resend.com). Verify your sending domain there first.
# Without RESEND_API_KEY/EMAIL_FROM the site still works: contact messages are
# stored and queued, but nothing is delivered until these are set.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Young Arbitrators Society <noreply@your-domain.com>

# Optional override for where contact-form mail goes. If unset, the admin
# "Contact Email" setting is used. Never taken from the visitor.
CONTACT_TO_EMAIL=

# Signs unsubscribe links AND derives confirmation tokens at delivery time (>= 32 random
# chars). Generate: openssl rand -base64 48
# Rotating it invalidates unsubscribe links already sent and any unsent confirmation
# emails, so keep it stable.
NEWSLETTER_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Authenticates the worker at /api/cron/email-outbox (>= 16 chars). Vercel Cron
# sends it automatically as "Authorization: Bearer <value>" when set.
CRON_SECRET=replace-with-a-long-random-string
